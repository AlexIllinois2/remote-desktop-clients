<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingScrollKeys"
    android:layout_width="56dp"
    android:layout_height="wrap_content"
    android:alpha="0.75">

    <LinearLayout
        android:id="@+id/scrollKeyCircles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/scrollKeyUp"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/floating_key_circle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/scroll_key_up"
            android:textColor="@android:color/white"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/scrollKeyDown"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/floating_key_circle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/scroll_key_down"
            android:textColor="@android:color/white"
            android:textSize="26sp" />

    </LinearLayout>

</FrameLayout>
